# ── Clerk Authentication ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Note: @clerk/nextjs v7 reads redirect targets from the <SignIn>/<SignUp>
# component props (forceRedirectUrl), not from NEXT_PUBLIC_CLERK_*_URL env
# vars, so those are intentionally omitted here.

# ── AI ──
# AI chat + NL2SQL use the Anthropic model via the AI SDK.
ANTHROPIC_API_KEY=sk-ant-...
# Whisper radio transcription (optional — /api/radio/transcribe).
OPENAI_API_KEY=sk-...

# ── Supabase (NL2SQL F1 database + Fantasy tables) ──
NEXT_PUBLIC_SUPABASE_URL=https://ohntpviowjdlqjozdani.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The Python ingest scripts (scripts/ingest.py) read these two instead:
SUPABASE_URL=https://ohntpviowjdlqjozdani.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Reddit (fan-reaction comment volume) ──
# Script-app credentials from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# ── Fantasy admin scorer ──
# Bearer token gating POST /api/fantasy/score.
FANTASY_ADMIN_TOKEN=a-long-random-string

# ── F1 live timing (optional) ──
# F1 TV session cookie enables the "full" SignalR telemetry stream (car
# position, tyre detail). Server-side only — never expose to the browser.
# Without it the app still works in reduced "public" stream mode.
F1TV_AUTH_COOKIE=login-session=...
